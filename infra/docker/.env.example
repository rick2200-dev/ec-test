# Database (per-service, Phase 3 split)
# Each service has its own Postgres instance. Override these when
# running services outside Docker Compose (e.g. with `air`).
NOTIFICATION_DATABASE_URL=postgres://ecmarket:localdev@localhost:5433/notification_dev?sslmode=disable
SUBSCRIPTION_DATABASE_URL=postgres://ecmarket:localdev@localhost:5434/subscription_dev?sslmode=disable
SHIPPING_DATABASE_URL=postgres://ecmarket:localdev@localhost:5435/shipping_dev?sslmode=disable
INVENTORY_DATABASE_URL=postgres://ecmarket:localdev@localhost:5436/inventory_dev?sslmode=disable
AUTH_DATABASE_URL=postgres://ecmarket:localdev@localhost:5437/auth_dev?sslmode=disable
INQUIRY_DATABASE_URL=postgres://ecmarket:localdev@localhost:5438/inquiry_dev?sslmode=disable
REVIEW_DATABASE_URL=postgres://ecmarket:localdev@localhost:5439/review_dev?sslmode=disable
SEARCH_DATABASE_URL=postgres://ecmarket:localdev@localhost:5440/search_dev?sslmode=disable
RECOMMEND_DATABASE_URL=postgres://ecmarket:localdev@localhost:5441/recommend_dev?sslmode=disable
CATALOG_DATABASE_URL=postgres://ecmarket:localdev@localhost:5442/catalog_dev?sslmode=disable
ORDER_DATABASE_URL=postgres://ecmarket:localdev@localhost:5443/order_dev?sslmode=disable

# Inquiry service (buyer↔seller threads)
INQUIRY_SERVICE_URL=http://localhost:8090

# Redis
REDIS_URL=redis://localhost:6379

# Pub/Sub Emulator
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJECT_ID=ec-marketplace-dev

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.ecmarket.example.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Vertex AI (disabled for local dev)
VERTEX_AI_ENABLED=false
GCP_PROJECT_ID=your-gcp-project

# RBAC (auth service <-> gateway internal authz)
# Shared secret used by the gateway to call auth service /internal/authz/*.
# Must be identical on both sides; gateway sends it as X-Internal-Token.
AUTH_INTERNAL_TOKEN=change-me-internal-token

# Shared secret gating the subscription service. Required by gateway (HTTP)
# and order (gRPC). Sent as X-Internal-Token (HTTP) / x-internal-token
# metadata (gRPC).
SUBSCRIPTION_INTERNAL_TOKEN=change-me-subscription-internal-token

# First-run super_admin bootstrap. If both are set on auth service startup
# and no super_admin exists yet for the tenant, the user identified by
# AUTH_BOOTSTRAP_SUPERADMIN_SUB (an Auth0 sub) is granted super_admin.
# Idempotent: a no-op once any super_admin exists.
AUTH_BOOTSTRAP_SUPERADMIN_SUB=
AUTH_BOOTSTRAP_TENANT_ID=
