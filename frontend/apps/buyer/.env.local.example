# -----------------------------------------------------------------------------
# Buyer app — local dev environment
# Copy to `.env.local` and fill in the Auth0 values.
# See docs/buyer-auth-setup.md for the step-by-step Auth0 tenant creation flow.
# -----------------------------------------------------------------------------

# BFF base URL for the browser → Next.js route handlers. Leave as-is.
NEXT_PUBLIC_API_URL=/api/gateway

# The Go gateway URL as seen from the Next.js server (NOT the browser).
# Localhost during dev; a Docker service name inside compose.
GATEWAY_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Auth0 — required. Values come from the Auth0 application you created.
# -----------------------------------------------------------------------------
# Random 32+ byte hex secret. Generate with: openssl rand -hex 32
AUTH0_SECRET=
# Public URL of this app. Must match "Allowed Callback URLs" in Auth0.
APP_BASE_URL=http://localhost:3000
# Auth0 tenant domain, e.g. dev-xxxxxx.us.auth0.com (no scheme).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# API identifier configured in Auth0 → APIs. Acts as the JWT audience.
AUTH0_AUDIENCE=https://api.ecmarket.local
# Extra scopes (offline_access gives you a refresh token).
AUTH0_SCOPE=openid profile email offline_access

# -----------------------------------------------------------------------------
# Buyer profile upsert — called by the Next.js BFF after Auth0 callback
# to POST /internal/buyers/upsert on the auth service.
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:8081
AUTH_INTERNAL_TOKEN=dev-internal-token
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
